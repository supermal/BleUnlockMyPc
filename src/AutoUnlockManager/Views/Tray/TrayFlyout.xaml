<UserControl
    x:Class="AutoUnlockManager.Views.Tray.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AutoUnlockManager.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="360"
    AutomationProperties.Name="AutoUnlock 速览"
    FontFamily="{StaticResource Ui.Font}"
    FontSize="{StaticResource Ui.Type.Body}"
    Foreground="{DynamicResource Ui.Text.Primary}">

    <!--  Margen para que la sombra no se recorte en el Popup  -->
    <Border Margin="12">
        <Border
            Background="{DynamicResource Ui.Bg.Flyout}"
            BorderBrush="{DynamicResource Ui.Stroke.Card}"
            BorderThickness="1"
            CornerRadius="{StaticResource Ui.Radius.Card}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.2" ShadowDepth="4" />
            </Border.Effect>
            <StackPanel>
                <!--  Cabecera: logo, nombre, estado del servicio, abrir el gestor  -->
                <DockPanel Margin="16,12,8,8">
                    <Button
                        Width="32"
                        Height="32"
                        AutomationProperties.Name="打开管理器"
                        Click="OnOpenClicked"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Ui.Button.Icon}"
                        ToolTip="打开管理器">
                        <ui:SymbolIcon Symbol="Open16" />
                    </Button>
                    <Border
                        Margin="8,0,4,0"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Ui.StatusBadge.Tone}"
                        Tag="{Binding ServiceBadgeTone}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,4,0" FontSize="12" Symbol="{Binding ServiceBadgeIcon}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding ServiceBadgeText}" />
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Width="20"
                            Height="20"
                            Background="{DynamicResource Ui.Primary}"
                            CornerRadius="5">
                            <Path
                                Width="16"
                                Height="16"
                                Data="M4,7.5 H9 A1.5,1.5 0 0 1 10.5,9 V12 A1.5,1.5 0 0 1 9,13.5 H4 A1.5,1.5 0 0 1 2.5,12 V9 A1.5,1.5 0 0 1 4,7.5 Z M4.5,7.5 V5.5 A2,2 0 0 1 8.5,5.5 M11.5,2.5 A3.5,3.5 0 0 1 13.5,4.5"
                                Stretch="Uniform"
                                Stroke="{DynamicResource Ui.OnPrimary}"
                                StrokeThickness="1.5" />
                        </Border>
                        <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" Text="AutoUnlock" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Margin="16,4,16,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Ui.TextStyle.Caption}">
                            <Run Text="最近匹配 " /><Run Text="{Binding LastMatchText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource Ui.Text.Secondary}" Symbol="Bluetooth16" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Ui.TextStyle.Caption}" Text="{Binding DeviceName}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,8,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Ui.TextStyle.Caption}">
                            <Run Text="5 秒均值 " /><Run Text="{Binding Avg5Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontFamily="{StaticResource Ui.Font.Display}"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="{Binding CurrentDbmText}" />
                            <TextBlock
                                Margin="8,0,0,6"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource Ui.TextStyle.Secondary}"
                                Text="dBm" />
                            <Border
                                Margin="8,0,0,0"
                                Style="{StaticResource Ui.StatusBadge.Tone}"
                                Tag="{Binding ZoneTone, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding Zone, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Text="{Binding ZoneText}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <controls:SignalChart
                        x:Name="Chart"
                        Height="64"
                        Margin="0,10,0,0"
                        AutomationProperties.Name="最近 60 秒信号"
                        AwayBrush="{DynamicResource Ui.Status.Danger.Fg}"
                        AxisBrush="{DynamicResource Ui.Stroke.Divider}"
                        LabelBrush="{DynamicResource Ui.Text.Tertiary}"
                        LineBrush="{DynamicResource Ui.Primary}"
                        NearBrush="{DynamicResource Ui.Status.Success.Fg}"
                        ShowAxisLabels="False"
                        SurfaceBrush="{DynamicResource Ui.Bg.Flyout}"
                        WindowSeconds="60" />
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Ui.Text.Tertiary}" Style="{StaticResource Ui.TextStyle.Caption}" Text="现在" />
                        <TextBlock Foreground="{DynamicResource Ui.Text.Tertiary}" Style="{StaticResource Ui.TextStyle.Caption}" Text="60 秒前" />
                    </DockPanel>

                    <Border
                        Margin="0,12,0,0"
                        Padding="12,10"
                        Background="{DynamicResource Ui.Bg.Layer}"
                        CornerRadius="{StaticResource Ui.Radius.Card}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="12"
                                Foreground="{DynamicResource Ui.Status.Info.Fg}"
                                Symbol="CircleHalfFill12" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding StateText}" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Ui.TextStyle.Secondary}" Text="{Binding StateSubText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border
                    Padding="16,12"
                    Background="{DynamicResource Ui.Bg.Layer}"
                    BorderBrush="{DynamicResource Ui.Stroke.Divider}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                    <UniformGrid Columns="2">
                        <Button
                            Margin="0,0,4,0"
                            HorizontalAlignment="Stretch"
                            Click="OnRestartClicked"
                            IsEnabled="{Binding CanRestart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource Ui.Button.Secondary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" Symbol="ArrowClockwise16" />
                                <TextBlock Text="重启服务" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="4,0,0,0"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenClicked"
                            Content="打开管理器"
                            Style="{StaticResource Ui.Button.Primary}" />
                    </UniformGrid>
                </Border>
            </StackPanel>
        </Border>
    </Border>
</UserControl>

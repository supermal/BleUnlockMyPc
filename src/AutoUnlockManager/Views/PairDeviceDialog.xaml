<ContentDialog
    x:Class="AutoUnlockManager.Views.PairDeviceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="配对新设备"
    CloseButtonText="关闭"
    DefaultButton="Close">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
            <StackPanel Spacing="12" MinWidth="560">
            <TextBlock Text="选择配对方式"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="20">
                <RadioButton x:Name="PeripheralModeRadio"
                             GroupName="PairMode"
                             Content="手机 / 手表（由设备发起）"
                             IsChecked="True"
                             Checked="OnModeChanged" />
                <RadioButton x:Name="CentralModeRadio"
                             GroupName="PairMode"
                             Content="耳机 / 鼠标等（由电脑发起）"
                             Checked="OnModeChanged" />
            </StackPanel>

            <!-- 方式一：电脑广播 0x180D，手机/手表主动配对 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel x:Name="PeripheralPanel" Spacing="8">
                    <TextBlock TextWrapping="Wrap"
                               Text="适用于 iPhone、iPad、Apple Watch 等能主动连接外设的设备。电脑会临时广播标准心率服务；手机/手表读取加密特征时，Windows 会完成配对。" />
                    <TextBlock x:Name="MachineNameText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="StartAdvertisingButton"
                                Content="开始广播"
                                Click="OnStartAdvertisingClicked" />
                        <Button x:Name="StopAdvertisingButton"
                                Content="停止广播"
                                Click="OnStopAdvertisingClicked"
                                IsEnabled="False" />
                        <ProgressRing x:Name="PeripheralProgress"
                                      Width="20" Height="20" IsActive="False" />
                    </StackPanel>
                    <TextBlock x:Name="PeripheralStatusText"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="操作提示：先在手机/手表的蓝牙设置里「忽略」本电脑的旧配对；然后开始广播，用 nRF Connect 连接本机名称（Apple Watch：设置 → 蓝牙 → 健康设备）。配对成功后本向导会自动读取新 IRK。" />
                </StackPanel>
            </Border>

            <!-- 方式二：电脑扫描并发起配对 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel x:Name="CentralPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap"
                               Text="适用于耳机、鼠标、键盘等不能主动连接电脑的 BLE 设备。请先把设备进入配对模式（指示灯闪烁），再开始扫描。" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="StartScanButton"
                                Content="开始扫描"
                                Click="OnStartScanClicked" />
                        <Button x:Name="StopScanButton"
                                Content="停止扫描"
                                Click="OnStopScanClicked"
                                IsEnabled="False" />
                        <Button x:Name="PairSelectedButton"
                                Content="配对所选设备"
                                Click="OnPairSelectedClicked"
                                IsEnabled="False" />
                        <ProgressRing x:Name="CentralProgress"
                                      Width="20" Height="20" IsActive="False" />
                    </StackPanel>
                    <ListView x:Name="DeviceList"
                              Height="200"
                              SelectionMode="Single"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="OnDeviceSelectionChanged" />
                    <TextBlock x:Name="CentralStatusText"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="注意：经典蓝牙耳机不会出现在 BLE 扫描列表。配对确认/PIN 由本向导直接弹出，不会打开 Windows 设置。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

        <!-- 配对确认/PIN 提示：由本应用完成，不打开 Windows 设置 -->
        <Border x:Name="PairingPromptOverlay"
                Background="#99000000"
                Padding="24"
                Visibility="Collapsed">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="PairingPromptTitle"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="PairingPromptMessage"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="PairingPinDisplay"
                               FontSize="30"
                               FontWeight="SemiBold"
                               IsTextSelectionEnabled="True"
                               Visibility="Collapsed" />
                    <TextBox x:Name="PairingPinBox"
                             Header="PIN"
                             PlaceholderText="请输入设备上显示的 PIN"
                             MaxLength="32"
                             Visibility="Collapsed" />
                    <TextBlock x:Name="PairingPromptError"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Right">
                        <Button x:Name="PairingRejectButton"
                                Content="取消"
                                Click="OnPairingRejectClicked" />
                        <Button x:Name="PairingAcceptButton"
                                Content="配对"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnPairingAcceptClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ContentDialog>

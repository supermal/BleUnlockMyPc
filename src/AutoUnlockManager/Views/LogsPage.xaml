<Page
    x:Class="AutoUnlockManager.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:logs="using:AutoUnlockManager.Core.Logs"
    xmlns:helpers="using:AutoUnlockManager.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="36,20,36,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Spacing="8">
            <TextBlock Text="日志" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.LogsDirText, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 横幅 -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.BannerVisible, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.BannerSeverity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}" />

        <!-- 工具栏 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox MinWidth="300"
                          ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.CanFollow, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="logs:LogFileInfo">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind FileName}" />
                                <TextBlock Text="{x:Bind helpers:LogRowVisuals.FileSizeText(Length)}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Click="OnRefreshClicked" ToolTipService.ToolTip="刷新文件清单">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Content="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}"
                        Click="OnTogglePauseClicked"
                        IsEnabled="{x:Bind ViewModel.CanFollow, Mode=OneWay}" />
                <ToggleButton IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}"
                              ToolTipService.ToolTip="停在底部时新行自动跟随；向上翻看时保持位置">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                        <TextBlock Text="自动滚动" />
                    </StackPanel>
                </ToggleButton>
                <Button Click="OnOpenFolderClicked" ToolTipService.ToolTip="打开日志所在文件夹">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                </Button>
                <Button Click="OnExportClicked" ToolTipService.ToolTip="导出当前过滤视图">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE792;" FontSize="14" />
                        <TextBlock Text="导出" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox Content="调试 (DBG)" IsChecked="{x:Bind ViewModel.ShowDebug, Mode=TwoWay}" />
                <CheckBox Content="信息 (INF)" IsChecked="{x:Bind ViewModel.ShowInformation, Mode=TwoWay}" />
                <CheckBox Content="警告 (WRN)" IsChecked="{x:Bind ViewModel.ShowWarning, Mode=TwoWay}" />
                <CheckBox Content="错误 (ERR)" IsChecked="{x:Bind ViewModel.ShowError, Mode=TwoWay}" />
                <TextBox Width="300"
                         PlaceholderText="关键字过滤（匹配整行原文）"
                         Text="{x:Bind ViewModel.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>

        <!-- 日志列表（虚拟化） -->
        <Border Grid.Row="3" Style="{StaticResource CardPanelStyle}" Padding="0">
            <ListView x:Name="LogList"
                      ItemsSource="{x:Bind ViewModel.VisibleEntries, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Padding="4,4,4,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="4,1,4,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="logs:LogEntry">
                        <Grid>
                            <Border Background="#FFB900" Opacity="0.10"
                                    Visibility="{x:Bind helpers:LogRowVisuals.WarningTint(Severity)}" />
                            <Border Background="#C42B1C" Opacity="0.10"
                                    Visibility="{x:Bind helpers:LogRowVisuals.ErrorTint(Severity)}" />
                            <Grid ColumnSpacing="10" Padding="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind TimeText}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{x:Bind LevelText}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayText}"
                                           FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="{x:Bind helpers:LogRowVisuals.TextOpacity(Severity)}"
                                           FontWeight="{x:Bind helpers:LogRowVisuals.MessageWeight(Severity)}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="4"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Page>

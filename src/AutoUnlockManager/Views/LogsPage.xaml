<UserControl
    x:Class="AutoUnlockManager.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AutoUnlockManager.Localization"
    xmlns:logs="clr-namespace:AutoUnlockManager.Core.Logs;assembly=AutoUnlockManager.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Loaded="OnLoaded">

    <UserControl.Resources>
        <!--  Filtro de nivel: píldora conmutable con recuento  -->
        <Style x:Key="LevelChip" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="{StaticResource Ui.Type.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ui.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Chip"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource Ui.Bg.Control}"
                            BorderBrush="{DynamicResource Ui.Stroke.Control}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Ui.Bg.Subtle.Selected}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Ui.Stroke.Control.Strong}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Ui.Bg.Control.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!--  El estilo de tema del sistema (Aero2) fija el texto en negro: se usa el pincel del tema  -->
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Row"
                            MinHeight="28"
                            Padding="24,4"
                            Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static logs:LogSeverity.Warning}">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ui.Status.Warning.Bg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static logs:LogSeverity.Error}">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ui.Status.Danger.Bg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static logs:LogSeverity.Fatal}">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ui.Status.Danger.Bg}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ui.Bg.Subtle.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LogRowTemplate" DataType="{x:Type logs:LogEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Ui.Font.Mono}"
                    FontSize="12"
                    Foreground="{DynamicResource Ui.Text.Tertiary}"
                    Text="{Binding TimeText}" />
                <TextBlock
                    x:Name="Level"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Ui.Font.Mono}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Ui.Text.Tertiary}"
                    Text="{Binding LevelText}" />
                <TextBlock
                    x:Name="Message"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static logs:LogSeverity.Warning}">
                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Ui.Status.Warning.Fg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static logs:LogSeverity.Error}">
                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Ui.Status.Danger.Fg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static logs:LogSeverity.Fatal}">
                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Ui.Status.Danger.Fg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static logs:LogSeverity.Debug}">
                    <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource Ui.Text.Secondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!--  Título + archivo + acciones  -->
        <DockPanel Margin="24,24,24,16" DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ComboBox
                    Width="240"
                    AutomationProperties.Name="{loc:Loc Logs_Files}"
                    DisplayMemberPath="FileName"
                    FontFamily="{StaticResource Ui.Font.Mono}"
                    ItemsSource="{Binding Files}"
                    SelectedItem="{Binding SelectedFile}" />
                <Button
                    Margin="8,0,0,0"
                    AutomationProperties.Name="{loc:Loc Logs_RefreshFiles}"
                    Click="OnRefreshClicked"
                    Style="{StaticResource Ui.Button.Icon}"
                    ToolTip="{loc:Loc Logs_RefreshFiles}">
                    <ui:SymbolIcon Symbol="ArrowClockwise16" />
                </Button>
                <Button
                    AutomationProperties.Name="{loc:Loc Logs_OpenFolder}"
                    Click="OnOpenFolderClicked"
                    Style="{StaticResource Ui.Button.Icon}"
                    ToolTip="{loc:Loc Logs_OpenFolder}">
                    <ui:SymbolIcon Symbol="Folder16" />
                </Button>
                <Button
                    Margin="8,0,0,0"
                    Click="OnExportClicked"
                    Style="{StaticResource Ui.Button.Secondary}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="ArrowDownload16" />
                        <TextBlock Text="{loc:Loc Logs_ExportView}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource Ui.TextStyle.Title}" Text="{loc:Loc Logs_Title}" />
        </DockPanel>

        <ui:InfoBar
            Title="{Binding BannerTitle}"
            Margin="24,0,24,12"
            DockPanel.Dock="Top"
            IsOpen="{Binding BannerVisible, Mode=TwoWay}"
            Message="{Binding BannerMessage}"
            Severity="{Binding BannerSeverity}" />

        <!--  Banda de filtros  -->
        <Border
            Padding="24,12"
            Background="{DynamicResource Ui.Bg.Layer}"
            BorderBrush="{DynamicResource Ui.Stroke.Divider}"
            BorderThickness="0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <ui:ToggleSwitch
                    Margin="16,0,0,0"
                    Content="{loc:Loc Logs_AutoFollow}"
                    DockPanel.Dock="Right"
                    IsChecked="{Binding AutoScroll}"
                    ToolTip="{loc:Loc Logs_AutoFollowTip}" />
                <ToggleButton IsChecked="{Binding ShowDebug}" Style="{StaticResource LevelChip}">
                    <TextBlock><Run Text="{loc:Loc Logs_LevelDebug}" /><Run Foreground="{DynamicResource Ui.Text.Tertiary}" Text="{Binding Counts.Debug, Mode=OneWay, StringFormat=N0}" /></TextBlock>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ShowInformation}" Style="{StaticResource LevelChip}">
                    <TextBlock><Run Text="{loc:Loc Logs_LevelInfo}" /><Run Foreground="{DynamicResource Ui.Text.Tertiary}" Text="{Binding Counts.Info, Mode=OneWay, StringFormat=N0}" /></TextBlock>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ShowWarning}" Style="{StaticResource LevelChip}">
                    <TextBlock Foreground="{DynamicResource Ui.Status.Warning.Fg}"><Run Text="{loc:Loc Logs_LevelWarning}" /><Run Text="{Binding Counts.Warning, Mode=OneWay, StringFormat=N0}" /></TextBlock>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ShowError}" Style="{StaticResource LevelChip}">
                    <TextBlock Foreground="{DynamicResource Ui.Status.Danger.Fg}"><Run Text="{loc:Loc Logs_LevelError}" /><Run Text="{Binding Counts.Error, Mode=OneWay, StringFormat=N0}" /></TextBlock>
                </ToggleButton>
                <ui:TextBox
                    MinWidth="220"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="{loc:Loc Logs_FilterName}"
                    Icon="{ui:SymbolIcon Search16}"
                    PlaceholderText="{loc:Loc Logs_FilterPlaceholder}"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>

        <!--  Barra de estado  -->
        <Border
            Padding="24,8"
            BorderBrush="{DynamicResource Ui.Stroke.Divider}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsFollowing, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource Ui.Status.Success.Fg}" Symbol="Checkmark12" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource Ui.Status.Success.Fg}" Text="{loc:Loc Logs_FollowingLatest}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource Ui.Text.Secondary}" Symbol="Pause12" />
                        <TextBlock Style="{StaticResource Ui.TextStyle.Caption}" Text="{loc:Loc Logs_Browsing}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource Ui.TextStyle.Caption}">
                    <Run Text="{Binding LineCountText, Mode=OneWay}" /><Run Text="{loc:Loc Logs_MaxLines}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!--  Lista virtualizada + «回到最新»  -->
        <Grid>
            <ListBox
                x:Name="LogList"
                Padding="0,4"
                AutomationProperties.Name="{loc:Loc Logs_ServiceLog}"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource LogRow}"
                ItemTemplate="{StaticResource LogRowTemplate}"
                ItemsSource="{Binding VisibleEntries}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling" />
            <Button
                Margin="0,0,24,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="OnJumpToLatestClicked"
                Cursor="Hand"
                Foreground="{DynamicResource Ui.Text.Primary}"
                Visibility="{Binding HasPendingNewLines, Converter={StaticResource BoolToVisibility}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Pill"
                            Height="32"
                            Padding="14,0"
                            Background="{DynamicResource Ui.Bg.Flyout}"
                            BorderBrush="{DynamicResource Ui.Stroke.Card}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Opacity="0.18" ShadowDepth="4" />
                            </Border.Effect>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="12" Symbol="ArrowDown12" />
                                <TextBlock FontSize="12">
                                    <Run Text="{loc:Loc Logs_NewLinesPrefix}" /><Run Text="{Binding PendingNewLines, Mode=OneWay}" /><Run Text="{loc:Loc Logs_NewLinesSuffix}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Ui.Bg.Control.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </DockPanel>
</UserControl>

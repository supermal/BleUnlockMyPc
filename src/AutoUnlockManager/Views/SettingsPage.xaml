<UserControl
    x:Class="AutoUnlockManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AutoUnlockManager.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Loaded="OnLoaded">

    <UserControl.Resources>
        <Style x:Key="GroupTitle" BasedOn="{StaticResource Ui.TextStyle.BodyStrong}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>

        <!--  Tarjeta de tema: vista previa en miniatura + radio; seleccionada = borde de acento  -->
        <Style x:Key="ThemeTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <!--  El estilo de tema del sistema (Aero2) fija el texto en negro: se usa el pincel del tema  -->
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text.Primary}" />
            <Setter Property="GroupName" Value="Theme" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ui.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Tile"
                            Padding="8,8,8,12"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Ui.Stroke.Card}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Ui.Radius.Card}">
                            <StackPanel>
                                <ContentPresenter Height="72" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Stroke="{DynamicResource Ui.Stroke.Control.Strong}"
                                        StrokeThickness="1" />
                                    <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Tag}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Ui.Bg.Subtle.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Ui.Primary}" />
                                <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Tile" Property="Padding" Value="7,7,7,11" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Ui.Primary}" />
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Fila de ubicación: nombre + ruta en monoespaciada + «打开文件夹»  -->
        <DataTemplate x:Key="PathRow">
            <Border Style="{StaticResource Ui.Card}">
                <DockPanel>
                    <Button
                        VerticalAlignment="Center"
                        Click="OnOpenPathClicked"
                        CommandParameter="{Binding Path}"
                        Content="打开文件夹"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Ui.Button.Secondary}" />
                    <StackPanel Margin="36,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock
                            FontFamily="{StaticResource Ui.Font.Mono}"
                            Style="{StaticResource Ui.TextStyle.Caption}"
                            Text="{Binding Path}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource Ui.Content.MaxWidth.Settings}" Margin="32,32,32,40">
            <TextBlock Style="{StaticResource Ui.TextStyle.Title}" Text="设置" />
            <TextBlock
                Margin="0,4,0,8"
                Style="{StaticResource Ui.TextStyle.Secondary}"
                Text="管理器自身的外观与启动方式。服务参数请到「配置」页修改。" />

            <!--  ===== Apariencia =====  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="外观" />
            <Border Padding="0" Style="{StaticResource Ui.Card}">
                <StackPanel>
                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            HorizontalAlignment="Left"
                            FontSize="20"
                            Foreground="{DynamicResource Ui.Icon.Primary}"
                            Symbol="DarkTheme20" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="应用主题" />
                            <TextBlock Style="{StaticResource Ui.TextStyle.Caption}" Text="立即应用到整个窗口，下次启动时保持。" />
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{DynamicResource Ui.Stroke.Divider}" BorderThickness="0,1,0,0">
                        <UniformGrid
                            Margin="16"
                            AutomationProperties.Name="应用主题"
                            Columns="3">
                            <RadioButton
                                Margin="0,0,8,0"
                                AutomationProperties.Name="跟随系统"
                                IsChecked="{Binding IsSystemTheme}"
                                Style="{StaticResource ThemeTile}"
                                Tag="跟随系统">
                                <Border BorderBrush="{DynamicResource Ui.Stroke.Card}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <UniformGrid Columns="2">
                                        <Border Padding="8" Background="#F3F3F3"><Border Background="#FFFFFF" CornerRadius="4" /></Border>
                                        <Border Padding="8" Background="#1C1C1C"><Border Background="#242424" CornerRadius="4" /></Border>
                                    </UniformGrid>
                                </Border>
                            </RadioButton>
                            <RadioButton
                                Margin="4,0"
                                AutomationProperties.Name="浅色"
                                IsChecked="{Binding IsLightTheme}"
                                Style="{StaticResource ThemeTile}"
                                Tag="浅色">
                                <Border Padding="28,8,8,8" Background="#F3F3F3" BorderBrush="{DynamicResource Ui.Stroke.Card}" BorderThickness="1" CornerRadius="4">
                                    <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" />
                                </Border>
                            </RadioButton>
                            <RadioButton
                                Margin="8,0,0,0"
                                AutomationProperties.Name="深色"
                                IsChecked="{Binding IsDarkTheme}"
                                Style="{StaticResource ThemeTile}"
                                Tag="深色">
                                <Border Padding="28,8,8,8" Background="#1C1C1C" BorderBrush="{DynamicResource Ui.Stroke.Card}" BorderThickness="1" CornerRadius="4">
                                    <Border Background="#242424" CornerRadius="4" />
                                </Border>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ===== Arranque =====  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="启动" />
            <controls:SettingRow
                Description="由安装脚本注册的计划任务以最高权限启动，不弹 UAC。关闭窗口后最小化到托盘。"
                Header="登录时自动启动"
                Icon="Power20">
                <Border Style="{StaticResource Ui.StatusBadge.Tone}" Tag="{Binding AutoStartTone}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Symbol="{Binding AutoStartTone, Converter={StaticResource ToneToSymbol}}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding AutoStartText}" />
                    </StackPanel>
                </Border>
            </controls:SettingRow>

            <!--  ===== Ubicación de los ficheros =====  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="文件位置" />
            <ContentPresenter Content="{Binding ConfigLocation, RelativeSource={RelativeSource AncestorType=UserControl}}" ContentTemplate="{StaticResource PathRow}" />
            <ContentPresenter Content="{Binding LogsLocation, RelativeSource={RelativeSource AncestorType=UserControl}}" ContentTemplate="{StaticResource PathRow}" />
            <ContentPresenter Content="{Binding InstallLocation, RelativeSource={RelativeSource AncestorType=UserControl}}" ContentTemplate="{StaticResource PathRow}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

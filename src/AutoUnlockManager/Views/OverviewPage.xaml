<UserControl
    x:Class="AutoUnlockManager.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AutoUnlockManager.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AutoUnlockManager.ViewModels">

    <UserControl.Resources>
        <!--  Insignia: icono según el tono + texto  -->
        <DataTemplate x:Key="ToneBadge">
            <Border Style="{StaticResource Ui.StatusBadge.Tone}" Tag="{Binding Tone}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Symbol="{Binding Tone, Converter={StaticResource ToneToSymbol}}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Value}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HealthRowTemplate" DataType="{x:Type vm:HealthRow}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Ui.TextStyle.Secondary}"
                    Text="{Binding Key}" />
                <ContentPresenter
                    x:Name="Badge"
                    Grid.Column="1"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource ToneBadge}" />
                <TextBlock
                    x:Name="Plain"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding Value}"
                    Visibility="Collapsed" />
                <TextBlock
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Ui.Text.Tertiary}"
                    Style="{StaticResource Ui.TextStyle.Caption}"
                    Text="{Binding Sub}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="plain">
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Plain" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource Ui.Content.MaxWidth.Workspace}" Margin="24,32,24,32">

            <!--  Título + acción secundaria  -->
            <DockPanel Margin="0,0,0,24">
                <Button
                    VerticalAlignment="Top"
                    Click="OnExportCsvClicked"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Ui.Button.Secondary}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="ArrowDownload16" />
                        <TextBlock Text="导出样本 CSV" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Ui.TextStyle.Title}" Text="概览" />
            </DockPanel>

            <ui:InfoBar
                Title="无法连接到服务"
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding ConnectionBannerVisible, Mode=OneWay}"
                Message="服务未运行或未安装；正在自动重试（每 2 秒）。"
                Severity="Warning" />
            <ui:InfoBar
                Title="{Binding BannerTitle}"
                Margin="0,0,0,12"
                IsOpen="{Binding BannerOpen, Mode=TwoWay}"
                Message="{Binding BannerMessage}"
                Severity="{Binding BannerSeverity}" />

            <!--  ===== Señal en directo =====  -->
            <Border
                Padding="20,20,20,16"
                AutomationProperties.Name="实时信号"
                Style="{StaticResource Ui.Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Ui.TextStyle.Caption}">
                                <Run Text="{Binding Telemetry.DeviceName, Mode=OneWay}" /><Run Text=" 当前信号" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{StaticResource Ui.Font.Display}"
                                    FontSize="40"
                                    FontWeight="SemiBold"
                                    Text="{Binding Telemetry.CurrentDbmText}" />
                                <TextBlock
                                    Margin="8,0,0,8"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource Ui.TextStyle.Secondary}"
                                    Text="dBm" />
                                <Border
                                    Margin="12,0,0,0"
                                    Style="{StaticResource Ui.StatusBadge.Tone}"
                                    Tag="{Binding ZoneTone}"
                                    Visibility="{Binding Telemetry.Zone, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="{Binding Telemetry.ZoneText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Ui.TextStyle.Caption}">
                                <Run Text="5 秒均值" /> <Run Text="{Binding Avg5Text, Mode=OneWay}" /><Run Text="　10 秒均值" /> <Run Text="{Binding Avg10Text, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border
                                Height="28"
                                Padding="12,0"
                                HorizontalAlignment="Right"
                                CornerRadius="14"
                                Style="{StaticResource Ui.StatusBadge.Tone}"
                                Tag="{Binding StateTone}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Symbol="{Binding StateTone, Converter={StaticResource ToneToSymbol}}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Ui.Type.Body}"
                                        Text="{Binding Telemetry.StateText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Ui.TextStyle.Caption}"
                                Text="{Binding StateSubText}" />
                        </StackPanel>
                    </Grid>

                    <controls:SignalChart
                        Height="242"
                        AutomationProperties.Name="最近 5 分钟信号曲线，含锁定与解锁阈值"
                        AwayBrush="{DynamicResource Ui.Status.Danger.Fg}"
                        AxisBrush="{DynamicResource Ui.Stroke.Divider}"
                        LabelBrush="{DynamicResource Ui.Text.Tertiary}"
                        LineBrush="{DynamicResource Ui.Primary}"
                        LockDbm="{Binding LockDbm}"
                        NearBrush="{DynamicResource Ui.Status.Success.Fg}"
                        NowMs="{Binding ChartNowMs}"
                        Points="{Binding ChartPoints}"
                        SurfaceBrush="{DynamicResource Ui.Bg.Card}"
                        UnlockDbm="{Binding UnlockDbm}" />

                    <Border
                        Margin="0,20,0,16"
                        BorderBrush="{DynamicResource Ui.Stroke.Divider}"
                        BorderThickness="0,1,0,0" />
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ui.TextStyle.BodyStrong}" Text="锁定周期" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource Ui.TextStyle.Caption}"
                            Text="解锁成功后回到「已解锁」；暂缓与挂起不在主线上" />
                    </StackPanel>
                    <controls:LockCycle Batch="{Binding Telemetry.Batch}" StateName="{Binding Telemetry.StateName}" />
                </StackPanel>
            </Border>

            <!--  ===== Salud del servicio y dispositivo =====  -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="20,16"
                    AutomationProperties.Name="服务与健康"
                    Style="{StaticResource Ui.Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button
                                    Margin="8,0,0,0"
                                    Click="OnStartServiceClicked"
                                    Content="启动服务"
                                    Style="{StaticResource Ui.Button.Primary}"
                                    Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Click="OnStopServiceClicked"
                                    Content="停止服务"
                                    IsEnabled="{Binding CanStopOrRestart}"
                                    Style="{StaticResource Ui.Button.Subtle}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Click="OnRestartServiceClicked"
                                    IsEnabled="{Binding CanStopOrRestart}"
                                    Style="{StaticResource Ui.Button.Secondary}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="ArrowClockwise16" />
                                        <TextBlock Text="重启服务" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource Ui.TextStyle.BodyStrong}"
                                Text="服务与健康" />
                        </DockPanel>
                        <ItemsControl
                            Focusable="False"
                            ItemTemplate="{StaticResource HealthRowTemplate}"
                            ItemsSource="{Binding HealthRows}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="20,16"
                    AutomationProperties.Name="目标设备"
                    Style="{StaticResource Ui.Card}">
                    <DockPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            DockPanel.Dock="Top"
                            Style="{StaticResource Ui.TextStyle.BodyStrong}"
                            Text="目标设备" />
                        <StackPanel Margin="0,0,0,12" DockPanel.Dock="Top" Orientation="Horizontal">
                            <Border
                                Width="40"
                                Height="40"
                                Background="{DynamicResource Ui.Bg.Layer}"
                                BorderBrush="{DynamicResource Ui.Stroke.Card}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Ui.Radius.Card}">
                                <ui:SymbolIcon
                                    FontSize="20"
                                    Foreground="{DynamicResource Ui.Icon.Primary}"
                                    Symbol="Bluetooth20" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Ui.TextStyle.BodyStrong}" Text="{Binding Telemetry.DeviceName}" />
                                <TextBlock
                                    FontFamily="{StaticResource Ui.Font.Mono}"
                                    Style="{StaticResource Ui.TextStyle.Caption}"
                                    Text="{Binding Telemetry.DeviceAddress}" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Left"
                            Click="OnChangeDeviceClicked"
                            Content="更换设备"
                            DockPanel.Dock="Bottom"
                            Style="{StaticResource Ui.Button.Secondary}" />
                        <TextBlock
                            Margin="0,0,0,12"
                            Style="{StaticResource Ui.TextStyle.Caption}"
                            Text="IRK 由服务从 Windows 蓝牙配对库读取，已加密保存在配置文件中。"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

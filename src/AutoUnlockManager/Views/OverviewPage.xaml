<Page
    x:Class="AutoUnlockManager.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AutoUnlockManager.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,20,36,36">
        <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock Text="概览" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="实时 dBm 曲线、状态与服务健康。"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 断线横幅：客户端自动重连中（设计 §5.5） -->
            <InfoBar IsOpen="{x:Bind ViewModel.ConnectionBannerVisible, Mode=OneWay}"
                     Severity="Warning"
                     Title="无法连接到服务"
                     Message="服务未运行或未安装；客户端正在自动重试（每 2 秒）。"
                     IsClosable="False" />

            <!-- 操作结果横幅（服务控制 / 导出） -->
            <InfoBar IsOpen="{x:Bind ViewModel.OperationBannerVisible, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.OperationBannerSeverity, Mode=OneWay}"
                     Title="{x:Bind ViewModel.OperationBannerTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.OperationBannerMessage, Mode=OneWay}" />

            <!-- 实时信号 -->
            <Border Style="{StaticResource CardPanelStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="当前信号"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.CurrentDbmText, Mode=OneWay}"
                                           FontSize="40"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="dBm"
                                           FontSize="16"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="5 秒均值"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Avg5Text, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="10 秒均值"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Avg10Text, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 状态芯片：中文状态 + 已持续时长 -->
                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.StateDurationText, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <controls:TelemetryChart x:Name="Chart" Height="220" />
                </StackPanel>
            </Border>

            <!-- 服务与健康 -->
            <Border Style="{StaticResource CardPanelStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="服务与健康" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="24" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="服务状态"
                                       Width="64"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ServiceStatusText, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="BLE 扫描"
                                       Width="64"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ScanValueText"
                                       Text="{x:Bind ViewModel.ScanText, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="助手连接"
                                       Width="64"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="HelperValueText"
                                       Text="{x:Bind ViewModel.HelperText, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="凭据连接"
                                       Width="64"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="CredValueText"
                                       Text="{x:Bind ViewModel.CredText, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="运行时长"
                                       Width="64"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="最近匹配"
                                       Width="64"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LastMatchValueText"
                                       Text="{x:Bind ViewModel.LastMatchText, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="启动服务"
                                Click="OnStartServiceClicked"
                                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" />
                        <Button Content="停止服务"
                                Click="OnStopServiceClicked"
                                IsEnabled="{x:Bind ViewModel.CanStopOrRestart, Mode=OneWay}" />
                        <Button Content="重启服务"
                                Click="OnRestartServiceClicked"
                                IsEnabled="{x:Bind ViewModel.CanStopOrRestart, Mode=OneWay}" />
                        <Button Click="OnExportCsvClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="导出 CSV" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

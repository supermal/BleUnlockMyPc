<Application
    x:Class="AutoUnlockManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DispatcherUnhandledException="OnDispatcherUnhandledException"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!--  Sistema de diseño (UiDesign.md): tokens, pinceles del tema y estilos  -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.xaml" />
                <!--  UiTheme sustituye este diccionario por Dark.xaml o alto contraste en tiempo de ejecución  -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

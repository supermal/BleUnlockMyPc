<ui:FluentWindow
    x:Class="AutoUnlockManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:AutoUnlockManager.Helpers"
    xmlns:models="clr-namespace:AutoUnlockManager.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AutoUnlock 管理器"
    Width="1280"
    Height="800"
    MinWidth="800"
    MinHeight="500"
    Background="{DynamicResource Ui.Bg.Canvas}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource Ui.Font}"
    FontSize="{StaticResource Ui.Type.Body}"
    Foreground="{DynamicResource Ui.Text.Primary}"
    Icon="pack://application:,,,/Assets/AppIcon.ico"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!--  Elemento de navegación: icono 20 + texto (separación 12) + contador opcional a la derecha  -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type models:NavItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="{DynamicResource Ui.Icon.Primary}"
                    Symbol="{Binding Icon}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="CountText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource Ui.Type.Caption}"
                    FontWeight="Normal"
                    Foreground="{DynamicResource Ui.Status.Warning.Fg}"
                    Text="{Binding Count}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Count}" Value="">
                    <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style
            x:Key="ShellNavItem"
            BasedOn="{StaticResource Ui.NavItem}"
            TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!--  Ui.Size.TopBar  -->
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!--  Ui.Size.Sidebar  -->
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ===== Barra de título (sección 4.1): estado del servicio junto a los botones de ventana =====  -->
        <ui:TitleBar
            x:Name="TitleBar"
            Grid.ColumnSpan="2"
            Height="{StaticResource Ui.Size.TopBar}">
            <ui:TitleBar.TrailingContent>
                <!--  Estado del servicio: icono + texto (el color solo acompaña)  -->
                <Border
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    DataContext="{Binding Telemetry, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Border.Style>
                        <Style BasedOn="{StaticResource Ui.StatusBadge}" TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServiceBadgeTone}" Value="ok">
                                    <Setter Property="Background" Value="{DynamicResource Ui.Status.Success.Bg}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ui.Status.Success.Fg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ServiceBadgeTone}" Value="danger">
                                    <Setter Property="Background" Value="{DynamicResource Ui.Status.Danger.Bg}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ui.Status.Danger.Fg}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Symbol="{Binding ServiceBadgeIcon}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding ServiceBadgeText}" />
                    </StackPanel>
                </Border>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!--  Logo 24 + nombre. Se superpone a TitleBar (IsHitTestVisible=False: la zona sigue arrastrando la ventana)  -->
        <StackPanel
            Grid.ColumnSpan="2"
            Margin="16,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Orientation="Horizontal">
            <Border
                Width="24"
                Height="24"
                Background="{DynamicResource Ui.Primary}"
                CornerRadius="6">
                <Path
                    Width="16"
                    Height="16"
                    Data="M4,7.5 H9 A1.5,1.5 0 0 1 10.5,9 V12 A1.5,1.5 0 0 1 9,13.5 H4 A1.5,1.5 0 0 1 2.5,12 V9 A1.5,1.5 0 0 1 4,7.5 Z M4.5,7.5 V5.5 A2,2 0 0 1 8.5,5.5 M11.5,2.5 A3.5,3.5 0 0 1 13.5,4.5"
                    Stretch="None"
                    Stroke="{DynamicResource Ui.OnPrimary}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.5" />
            </Border>
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Ui.TextStyle.BodyStrong}"
                Text="AutoUnlock 管理器" />
        </StackPanel>

        <!--  ===== Navegación lateral: sobre el lienzo, sin fondo propio =====  -->
        <DockPanel
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,4,0,8">
            <StackPanel DockPanel.Dock="Bottom">
                <!--  Vista rápida del dispositivo: nombre, dBm actual y estado  -->
                <StackPanel
                    Margin="20,0,16,12"
                    AutomationProperties.Name="目标设备速览"
                    DataContext="{Binding Telemetry, RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource Ui.Text.Secondary}"
                            Symbol="Bluetooth16" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Ui.TextStyle.Caption}"
                            Text="{Binding DeviceName}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock
                            VerticalAlignment="Bottom"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Ui.TextStyle.Caption}"
                            Text="{Binding StateText}" />
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding CurrentDbmText}" />
                        <TextBlock
                            Margin="6,0,0,1"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource Ui.TextStyle.Caption}"
                            Text="dBm" />
                    </DockPanel>
                </StackPanel>
                <ListBox
                    x:Name="FooterList"
                    AutomationProperties.Name="底部导航"
                    ItemContainerStyle="{StaticResource ShellNavItem}"
                    ItemTemplate="{StaticResource NavItemTemplate}"
                    ItemsSource="{Binding FooterItems, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectionChanged="OnNavSelectionChanged"
                    Style="{StaticResource Ui.NavList}" />
            </StackPanel>

            <ListBox
                x:Name="MenuList"
                AutomationProperties.Name="主导航"
                ItemContainerStyle="{StaticResource ShellNavItem}"
                ItemTemplate="{StaticResource NavItemTemplate}"
                ItemsSource="{Binding MenuItems, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectionChanged="OnNavSelectionChanged"
                Style="{StaticResource Ui.NavList}" />
        </DockPanel>

        <!--  ===== Isla principal: cada página gestiona su propio desplazamiento =====  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            helpers:UiClip.ToCornerRadius="True"
            Style="{StaticResource Ui.Island}">
            <ContentControl x:Name="PageHost" Focusable="False" />
        </Border>

        <ui:ContentDialogHost
            x:Name="RootContentDialog"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2" />
    </Grid>
</ui:FluentWindow>

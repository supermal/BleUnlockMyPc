<UserControl
    x:Class="BleUnlockManager.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BleUnlockManager.Localization"
    xmlns:rules="clr-namespace:BleUnlockManager.Core.Rules;assembly=BleUnlockManager.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:BleUnlockManager.ViewModels">

    <UserControl.Resources>
        <!--  Rótulo de flecha: texto pequeño centrado sobre el lienzo del diagrama  -->
        <Style x:Key="EdgeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text.Secondary}" />
        </Style>
        <Style
            x:Key="EdgeLabelOk"
            BasedOn="{StaticResource EdgeLabel}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Status.Success.Fg}" />
        </Style>

        <Style x:Key="Edge" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Ui.Stroke.Control.Strong}" />
            <Setter Property="StrokeThickness" Value="1.4" />
        </Style>
        <Style
            x:Key="EdgeOk"
            BasedOn="{StaticResource Edge}"
            TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Ui.Status.Success.Fg}" />
        </Style>
        <Style x:Key="Head" TargetType="Polygon">
            <Setter Property="Fill" Value="{DynamicResource Ui.Stroke.Control.Strong}" />
        </Style>
        <Style
            x:Key="HeadOk"
            BasedOn="{StaticResource Head}"
            TargetType="Polygon">
            <Setter Property="Fill" Value="{DynamicResource Ui.Status.Success.Fg}" />
        </Style>

        <!--  Estado del diagrama: botón que salta a su sección; el actual lleva borde de acento  -->
        <DataTemplate x:Key="FlowNodeTemplate" DataType="{x:Type vm:FlowNode}">
            <Button
                AutomationProperties.Name="{Binding Name}"
                Click="OnNodeClicked"
                Cursor="Hand"
                Tag="{Binding Section}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Box"
                                Width="160"
                                Height="64"
                                Padding="10,8"
                                Background="{DynamicResource Ui.Bg.Card}"
                                BorderBrush="{DynamicResource Ui.Stroke.Control}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="NameText"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="SubText"
                                        Margin="0,2,0,0"
                                        Foreground="{DynamicResource Ui.Text.Tertiary}"
                                        Style="{StaticResource Ui.TextStyle.Caption}"
                                        Text="{Binding Sub}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                                        <ProgressBar
                                            Height="4"
                                            Margin="0,4,0,3"
                                            Maximum="1"
                                            Value="{Binding Progress, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Ui.Primary}"
                                            Text="{Binding ProgressText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="NowBadge"
                                Height="18"
                                Margin="0,-10,8,0"
                                Padding="8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Ui.Primary}"
                                CornerRadius="9"
                                Visibility="Collapsed">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Ui.OnPrimary}"
                                    Text="{loc:Loc Rules_Now}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ui.Bg.Control.Hover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSide}" Value="True">
                                <Setter TargetName="Box" Property="Width" Value="150" />
                                <Setter TargetName="Box" Property="Height" Value="56" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Ui.Status.Danger.Fg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ui.Primary}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ui.Status.Info.Bg}" />
                                <Setter TargetName="NowBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                <Setter TargetName="SubText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ProgressPanel" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!--  Elemento de lista: etiqueta en negrita opcional + texto  -->
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type rules:RuleItem}">
            <DockPanel Margin="0,0,0,6">
                <TextBlock
                    Width="16"
                    DockPanel.Dock="Left"
                    Foreground="{DynamicResource Ui.Text.Tertiary}"
                    Text="•" />
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="{Binding Key, Mode=OneWay}" /> <Run Text="{Binding Text, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParamTemplate" DataType="{x:Type rules:RuleParam}">
            <Border BorderBrush="{DynamicResource Ui.Stroke.Divider}" BorderThickness="0,1,0,0">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock
                            x:Name="ValueText"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold"
                            Text="{Binding Value}" />
                        <TextBlock
                            x:Name="DefaultText"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Foreground="{DynamicResource Ui.Text.Tertiary}"
                            Text="{Binding DefaultText}"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Foreground="{DynamicResource Ui.Text.Secondary}"
                        Text="{Binding Effect}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Changed}" Value="True">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Ui.Primary}" />
                    <Setter TargetName="DefaultText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type rules:RuleRow}">
            <Border
                x:Name="RowBorder"
                BorderBrush="{DynamicResource Ui.Stroke.Divider}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.45*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="Tone" Fill="Transparent" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,8"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Ui.Text.Secondary}"
                        Text="{Binding Number}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="0,8,16,8"
                        TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{Binding Key, Mode=OneWay}" /> <Run Text="{Binding Text, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="3"
                        Margin="0,8,12,8"
                        Text="{Binding Result}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter TargetName="Tone" Property="Fill" Value="{DynamicResource Ui.Status.Success.Fg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter TargetName="Tone" Property="Fill" Value="{DynamicResource Ui.Status.Danger.Fg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:RuleSectionView}">
            <Border
                Padding="0,20,0,4"
                BorderBrush="{DynamicResource Ui.Stroke.Divider}"
                BorderThickness="0,1,0,0">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <Border
                            MinWidth="24"
                            Height="24"
                            Margin="0,0,10,0"
                            Background="{DynamicResource Ui.Bg.Badge}"
                            CornerRadius="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Ui.Text.Secondary}"
                                Text="{Binding Section.Number}" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Ui.TextStyle.Subtitle}"
                            Text="{Binding Section.Title}" />
                    </StackPanel>

                    <TextBlock
                        MaxWidth="760"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource Ui.Text.Secondary}"
                        Text="{Binding Section.Lead}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasLead, Converter={StaticResource BoolToVisibility}}" />

                    <!--  Tabla de parámetros  -->
                    <Border
                        Margin="0,0,0,14"
                        BorderBrush="{DynamicResource Ui.Stroke.Card}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding HasParams, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="12,8" TextElement.Foreground="{DynamicResource Ui.Text.Secondary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Rules_ColParam}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    HorizontalAlignment="Right"
                                    FontWeight="SemiBold"
                                    Text="{loc:Loc Rules_ColValue}" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontWeight="SemiBold"
                                    Text="{loc:Loc Rules_ColEffect}" />
                            </Grid>
                            <ItemsControl ItemTemplate="{StaticResource ParamTemplate}" ItemsSource="{Binding Section.Params}" />
                        </StackPanel>
                    </Border>

                    <!--  Tabla de la sección 4  -->
                    <Border
                        Margin="0,0,0,14"
                        BorderBrush="{DynamicResource Ui.Stroke.Card}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,8" TextElement.Foreground="{DynamicResource Ui.Text.Secondary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0.45*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="#" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontWeight="SemiBold"
                                    Text="{loc:Loc Rules_ColCond}" />
                                <TextBlock
                                    Grid.Column="3"
                                    FontWeight="SemiBold"
                                    Text="{loc:Loc Rules_ColResult}" />
                            </Grid>
                            <ItemsControl ItemTemplate="{StaticResource RowTemplate}" ItemsSource="{Binding Section.Rows}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl
                        MaxWidth="820"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        ItemTemplate="{StaticResource ItemTemplate}"
                        ItemsSource="{Binding Section.Items}"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />

                    <!--  Ejemplos numerados  -->
                    <ItemsControl ItemsSource="{Binding Groups}" Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RuleGroupView}">
                                <StackPanel MaxWidth="820" Margin="0,0,0,12" HorizontalAlignment="Left">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:RuleStepView}">
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock
                                                        Width="22"
                                                        DockPanel.Dock="Left"
                                                        Foreground="{DynamicResource Ui.Text.Secondary}"
                                                        Text="{Binding Number, StringFormat={}{0}.}" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="Scroller"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="PageRoot"
            MaxWidth="1040"
            Margin="24,32,24,32">

            <DockPanel Margin="0,0,0,16">
                <Border
                    Margin="12,8,0,0"
                    VerticalAlignment="Top"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Ui.StatusBadge.Tone}"
                    Tag="{Binding SourceTone}">
                    <TextBlock Text="{Binding SourceText}" />
                </Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource Ui.TextStyle.Title}" Text="{loc:Loc Rules_Title}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Ui.TextStyle.Secondary}"
                        Text="{loc:Loc Rules_Desc}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <ui:InfoBar
                Title="{loc:Loc Rules_DefaultsTitle}"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="{Binding UsingDefaults, Mode=OneWay}"
                Message="{loc:Loc Rules_DefaultsBody}"
                Severity="Warning" />

            <!--  ===== Diagrama de estados =====  -->
            <Border
                Margin="0,0,0,28"
                Padding="16,16,16,12"
                AutomationProperties.Name="{loc:Loc Rules_FlowName}"
                Style="{StaticResource Ui.Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Foreground="{DynamicResource Ui.Text.Tertiary}"
                            Style="{StaticResource Ui.TextStyle.Caption}"
                            Text="{loc:Loc Rules_FlowHint}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource Ui.TextStyle.BodyStrong}"
                                Text="{loc:Loc Rules_FlowTitle}" />
                            <Border
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Ui.StatusBadge.Tone}"
                                Tag="{Binding LiveTone}">
                                <TextBlock Text="{Binding LiveText}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Canvas Width="960" Height="360">
                            <!--  Línea principal  -->
                            <Path Data="M160,182 H192" Style="{StaticResource Edge}" />
                            <Path Data="M360,182 H392" Style="{StaticResource Edge}" />
                            <Path Data="M560,182 H592" Style="{StaticResource Edge}" />
                            <Path Data="M760,182 H792" Style="{StaticResource Edge}" />
                            <Polygon Points="199,182 191,178 191,186" Style="{StaticResource Head}" />
                            <Polygon Points="399,182 391,178 391,186" Style="{StaticResource Head}" />
                            <Polygon Points="599,182 591,178 591,186" Style="{StaticResource Head}" />
                            <Polygon Points="799,182 791,178 791,186" Style="{StaticResource Head}" />
                            <!--  Retirar el aviso y desbloqueo correcto (vuelven a Desbloqueado)  -->
                            <Path Data="M260,150 C260,100 120,100 120,142" Style="{StaticResource EdgeOk}" />
                            <Polygon Points="120,149 116,141 124,141" Style="{StaticResource HeadOk}" />
                            <Path Data="M900,150 C900,18 60,18 60,142" Style="{StaticResource EdgeOk}" />
                            <Polygon Points="60,149 56,141 64,141" Style="{StaticResource HeadOk}" />
                            <!--  Fallo o tiempo agotado: vuelve a vigilar  -->
                            <Path Data="M860,150 C860,104 700,104 700,142" Style="{StaticResource Edge}" />
                            <Polygon Points="700,149 696,141 704,141" Style="{StaticResource Head}" />
                            <!--  Aplazamiento  -->
                            <Path Data="M280,214 V282" Style="{StaticResource Edge}" />
                            <Polygon Points="280,289 276,281 284,281" Style="{StaticResource Head}" />
                            <Path Data="M205,318 C110,318 80,280 80,224" Style="{StaticResource Edge}" />
                            <Polygon Points="80,217 76,225 84,225" Style="{StaticResource Head}" />

                            <TextBlock Canvas.Left="110" Canvas.Top="84" Width="160" Style="{StaticResource EdgeLabelOk}" Text="{Binding EdgeWithdraw}" />
                            <TextBlock Canvas.Left="380" Canvas.Top="40" Width="200" Style="{StaticResource EdgeLabelOk}" Text="{Binding EdgeSuccess}" />
                            <TextBlock Canvas.Left="700" Canvas.Top="88" Width="160" Style="{StaticResource EdgeLabel}" Text="{Binding EdgeFail}" />
                            <TextBlock Canvas.Left="105" Canvas.Top="222" Width="150" Style="{StaticResource EdgeLabel}" Text="{Binding EdgeLeave}" />
                            <TextBlock Canvas.Left="305" Canvas.Top="222" Width="150" Style="{StaticResource EdgeLabel}" Text="{Binding EdgeConfirm}" />
                            <TextBlock Canvas.Left="505" Canvas.Top="222" Width="150" Style="{StaticResource EdgeLabel}" Text="{Binding EdgeDepart}" />
                            <TextBlock Canvas.Left="705" Canvas.Top="222" Width="150" Style="{StaticResource EdgeLabel}" Text="{Binding EdgeNear}" />
                            <TextBlock Canvas.Left="102" Canvas.Top="256" Width="170" TextAlignment="Right" Style="{StaticResource EdgeLabel}" Text="{Binding EdgeSnoozeIn}" />
                            <TextBlock Canvas.Left="0" Canvas.Top="334" Width="200" TextAlignment="Left" Style="{StaticResource EdgeLabel}" Text="{Binding EdgeSnoozeOut}" />

                            <ItemsControl
                                Width="960"
                                Height="360"
                                ItemTemplate="{StaticResource FlowNodeTemplate}"
                                ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Canvas>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!--  ===== Secciones =====  -->
            <ItemsControl
                x:Name="SectionsList"
                Focusable="False"
                ItemTemplate="{StaticResource SectionTemplate}"
                ItemsSource="{Binding Sections}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

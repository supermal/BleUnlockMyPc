<UserControl
    x:Class="BleUnlockManager.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:BleUnlockManager.Localization"
    xmlns:controls="clr-namespace:BleUnlockManager.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Loaded="OnLoaded">

    <UserControl.Resources>
        <!--  Acción destructiva de baja prioridad: texto en rojo, gris si está deshabilitada  -->
        <Style x:Key="DangerSubtle" BasedOn="{StaticResource Ui.Button.Subtle}" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ui.Status.Danger.Fg}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Ui.Text.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroupTitle" BasedOn="{StaticResource Ui.TextStyle.BodyStrong}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!--  ===== Barra de cambios sin guardar: fija al pie de la isla =====  -->
        <Border
            Padding="24,12"
            Background="{DynamicResource Ui.Bg.Layer}"
            BorderBrush="{DynamicResource Ui.Stroke.Divider}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Margin="8,0,0,0"
                        Click="OnReloadClicked"
                        Content="{loc:Loc Config_ReloadFromDisk}"
                        Style="{StaticResource Ui.Button.Subtle}" />
                    <Button
                        Margin="8,0,0,0"
                        Click="OnDiscardClicked"
                        Content="{loc:Loc Config_Discard}"
                        IsEnabled="{Binding HasPendingChanges}"
                        Style="{StaticResource Ui.Button.Secondary}" />
                    <Button
                        Margin="8,0,0,0"
                        Click="OnSaveClicked"
                        Content="{loc:Loc Config_Save}"
                        Style="{StaticResource Ui.Button.Primary}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource AllTrue}">
                                <Binding Path="HasPendingChanges" />
                                <Binding Path="CanSave" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Margin="0,0,8,0"
                        Style="{StaticResource Ui.StatusBadge.Tone}"
                        Tag="info"
                        Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock>
                            <Run Text="{Binding PendingCount, Mode=OneWay}" /><Run Text="{loc:Loc Config_PendingSuffix}" />
                        </TextBlock>
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource Ui.TextStyle.Secondary}"
                        Text="{Binding PendingSummary}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource Ui.TextStyle.Secondary}"
                        Text="{loc:Loc Config_InSync}"
                        Visibility="{Binding HasPendingChanges, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource Ui.Content.MaxWidth.Settings}" Margin="32,32,32,40">

                <!--  Título  -->
                <DockPanel Margin="0,0,0,8">
                    <Button
                        VerticalAlignment="Top"
                        Click="OnOpenFolderClicked"
                        DockPanel.Dock="Right"
                        IsEnabled="{Binding CanOpenFolder}"
                        Style="{StaticResource Ui.Button.Subtle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,8,0" Symbol="Folder16" />
                            <TextBlock Text="{loc:Loc Config_OpenFolder}" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Ui.TextStyle.Title}" Text="{loc:Loc Config_Title}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Ui.TextStyle.Secondary}"
                            Text="{loc:Loc Config_Subtitle}" />
                    </StackPanel>
                </DockPanel>

                <ui:InfoBar
                    Title="{loc:Loc Config_FileUnavailable}"
                    Margin="0,8,0,0"
                    IsClosable="False"
                    IsOpen="{Binding PathWarningVisible, Mode=OneWay}"
                    Message="{Binding PathWarningText}"
                    Severity="Warning" />
                <ui:InfoBar
                    Title="{Binding BannerTitle}"
                    Margin="0,8,0,0"
                    IsOpen="{Binding BannerVisible, Mode=TwoWay}"
                    Message="{Binding BannerMessage}"
                    Severity="{Binding BannerSeverity}">
                    <Button
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Click="OnBannerActionClicked"
                        Content="{Binding BannerActionText}"
                        Style="{StaticResource Ui.Button.Secondary}"
                        Visibility="{Binding BannerActionVisible, Converter={StaticResource BoolToVisibility}}" />
                </ui:InfoBar>

                <StackPanel IsEnabled="{Binding CanEdit}">

                    <!--  ===== Dispositivo =====  -->
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc Config_UnlockDevice}" />
                    <Border Padding="0" Style="{StaticResource Ui.Card}">
                        <StackPanel>
                            <Grid Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    HorizontalAlignment="Left"
                                    FontSize="20"
                                    Foreground="{DynamicResource Ui.Icon.Primary}"
                                    Symbol="Bluetooth20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Loc Config_BluetoothDevice}" />
                                        <Border
                                            Margin="8,0,0,0"
                                            Style="{StaticResource Ui.StatusBadge.Tone}"
                                            Tag="info"
                                            Visibility="{Binding ModifiedFields, Converter={StaticResource FieldModifiedToVisibility}, ConverterParameter=Device.Irk}">
                                            <TextBlock Text="{loc:Loc Common_Modified}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,2,16,0"
                                        Style="{StaticResource Ui.TextStyle.Caption}"
                                        Text="{loc:Loc Config_BluetoothDeviceHint}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,16,0"
                                        FontSize="{StaticResource Ui.Type.Caption}"
                                        Foreground="{DynamicResource Ui.Status.Danger.Fg}"
                                        Text="{Binding IrkError}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasIrkError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    Width="300"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:Loc Config_BluetoothDevice}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding BondedDevices}"
                                    SelectedItem="{Binding SelectedBondDevice}" />
                                <ToggleButton
                                    x:Name="AdvancedToggle"
                                    Grid.Column="3"
                                    Width="32"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:Loc Config_Advanced}"
                                    IsChecked="True"
                                    Style="{StaticResource Ui.ExpanderToggle}"
                                    ToolTip="{loc:Loc Config_Advanced}" />
                            </Grid>
                            <!--  Seguimiento por MAC: aviso fijo de suplantación mientras esté elegido  -->
                            <ui:InfoBar
                                Title="{loc:Loc MacRisk_Title}"
                                Margin="52,0,16,12"
                                IsClosable="False"
                                IsOpen="{Binding IsMacTracking, Mode=OneWay}"
                                Message="{loc:Loc MacRisk_Message}"
                                Severity="Warning" />
                            <Border BorderBrush="{DynamicResource Ui.Stroke.Divider}" BorderThickness="0,1,0,0">
                                <DockPanel Margin="52,10,16,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Click="OnRefreshBondsClicked" Style="{StaticResource Ui.Button.Subtle}" ToolTip="{loc:Loc Config_RefreshBondsTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,8,0" Symbol="ArrowClockwise16" />
                                                <TextBlock Text="{loc:Loc Config_RefreshList}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Margin="8,0,0,0"
                                            Click="OnUnpairDeviceClicked"
                                            Content="{loc:Loc Config_Unpair}"
                                            IsEnabled="{Binding CanUnpairSelectedDevice}"
                                            Style="{StaticResource DangerSubtle}"
                                            ToolTip="{loc:Loc Config_UnpairTip}" />
                                        <Button
                                            Margin="8,0,0,0"
                                            Click="OnPairDeviceClicked"
                                            Style="{StaticResource Ui.Button.Secondary}"
                                            ToolTip="{loc:Loc Config_PairNewTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,8,0" Symbol="Add16" />
                                                <TextBlock Text="{loc:Loc Config_PairNew}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Ui.TextStyle.Caption}"
                                        Text="{Binding BondStatusText}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <StackPanel Background="{DynamicResource Ui.Bg.Layer}" Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVisibility}}">
                                <Border BorderBrush="{DynamicResource Ui.Stroke.Divider}" BorderThickness="0,1,0,0">
                                    <DockPanel Margin="52,12,16,12">
                                        <ComboBox
                                            Width="200"
                                            AutomationProperties.Name="{loc:Loc Config_IrkByteOrder}"
                                            DockPanel.Dock="Right"
                                            SelectedIndex="{Binding IrkByteOrderIndex}">
                                            <ComboBoxItem Content="{loc:Loc Config_ByteOrderAuto}" />
                                            <ComboBoxItem Content="{loc:Loc Config_ByteOrderNormal}" />
                                            <ComboBoxItem Content="{loc:Loc Config_ByteOrderReversed}" />
                                        </ComboBox>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc Config_IrkByteOrder}" />
                                            <TextBlock Style="{StaticResource Ui.TextStyle.Caption}" Text="{loc:Loc Config_IrkByteOrderHint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Ui.Stroke.Divider}" BorderThickness="0,1,0,0">
                                    <DockPanel Margin="52,12,16,12">
                                        <ui:TextBox
                                            Width="200"
                                            AutomationProperties.Name="{loc:Loc Config_AddressOptional}"
                                            DockPanel.Dock="Right"
                                            FontFamily="{StaticResource Ui.Font.Mono}"
                                            PlaceholderText="AA:BB:CC:DD:EE:FF"
                                            Text="{Binding IdentityAddressText, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc Config_AddressOptional}" />
                                            <TextBlock Style="{StaticResource Ui.TextStyle.Caption}" Text="{loc:Loc Config_AddressHint}" />
                                            <TextBlock
                                                FontSize="{StaticResource Ui.Type.Caption}"
                                                Foreground="{DynamicResource Ui.Status.Danger.Fg}"
                                                Text="{Binding IdentityAddressError}"
                                                Visibility="{Binding HasIdentityAddressError, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ===== Credenciales =====  -->
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc Config_Credentials}" />
                    <controls:SettingRow
                        Description="{loc:Loc Config_UserNameHint}"
                        Error="{Binding UserNameError}"
                        Header="{loc:Loc Config_UserName}"
                        Icon="Person20"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Credentials.UserName}">
                        <ui:TextBox
                            Width="300"
                            AutomationProperties.Name="{loc:Loc Config_UserName}"
                            Text="{Binding UserNameText, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingRow>
                    <!--  La contraseña guardada no entra en el campo: solo se escribe una nueva,
                         y el ojo aparece únicamente con lo recién escrito  -->
                    <controls:SettingRow
                        Description="{Binding PasswordDescription}"
                        Error="{Binding PasswordError}"
                        Header="{loc:Loc Config_Password}"
                        Icon="Key20"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Credentials.Password}">
                        <ui:PasswordBox
                            x:Name="PasswordInput"
                            Width="300"
                            AutomationProperties.Name="{loc:Loc Config_Password}"
                            Password="{Binding PasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding PasswordPlaceholder}"
                            RevealButtonEnabled="{Binding CanRevealPassword}" />
                    </controls:SettingRow>

                    <!--  ===== Proximidad =====  -->
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc Config_Proximity}" />
                    <Border Padding="16" Style="{StaticResource Ui.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontSize="20"
                                Foreground="{DynamicResource Ui.Icon.Primary}"
                                Symbol="CellularData120" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Loc Config_Thresholds}" />
                                <TextBlock Style="{StaticResource Ui.TextStyle.Caption}" Text="{loc:Loc Config_ThresholdsHint}" />
                                <controls:ThresholdBar
                                    Margin="8,8,8,4"
                                    AutomationProperties.Name="{loc:Loc Config_ThresholdsDiagram}"
                                    AwayBrush="{DynamicResource Ui.Status.Danger.Bg}"
                                    AwayTextBrush="{DynamicResource Ui.Status.Danger.Fg}"
                                    HoldBrush="{DynamicResource Ui.Bg.Badge}"
                                    LabelBrush="{DynamicResource Ui.Text.Secondary}"
                                    LockDbm="{Binding LockThresholdPreview}"
                                    MarkBrush="{DynamicResource Ui.Text.Primary}"
                                    NearBrush="{DynamicResource Ui.Status.Success.Bg}"
                                    NearTextBrush="{DynamicResource Ui.Status.Success.Fg}"
                                    UnlockDbm="{Binding UnlockThresholdPreview}" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" Text="{loc:Loc Config_LockThreshold}" />
                                        <controls:UnitTextBox
                                            AutomationProperties.Name="{loc:Loc Config_LockThreshold}"
                                            Text="{Binding LockThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                            Unit="dBm" />
                                    </StackPanel>
                                    <StackPanel Margin="24,0,0,0">
                                        <TextBlock Margin="0,0,0,6" Text="{loc:Loc Config_UnlockThreshold}" />
                                        <controls:UnitTextBox
                                            AutomationProperties.Name="{loc:Loc Config_UnlockThreshold}"
                                            Text="{Binding UnlockThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                            Unit="dBm" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="24,0,0,6"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource Ui.TextStyle.Caption}"
                                        Text="{loc:Loc Config_ThresholdOrderError}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="{StaticResource Ui.Type.Caption}"
                                    Foreground="{DynamicResource Ui.Status.Danger.Fg}"
                                    Text="{Binding LockThresholdError}"
                                    Visibility="{Binding HasLockThresholdError, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="{StaticResource Ui.Type.Caption}"
                                    Foreground="{DynamicResource Ui.Status.Danger.Fg}"
                                    Text="{Binding UnlockThresholdError}"
                                    Visibility="{Binding HasUnlockThresholdError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <controls:SettingRow
                        Description="{loc:Loc Config_UnlockCountHint}"
                        Error="{Binding UnlockCountError}"
                        Header="{loc:Loc Config_UnlockCount}"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Proximity.UnlockSampleCount}">
                        <controls:UnitTextBox AutomationProperties.Name="{loc:Loc Config_UnlockCount}" Text="{Binding UnlockCountText, UpdateSourceTrigger=PropertyChanged}" Unit="{loc:Loc Unit_Readings}" />
                    </controls:SettingRow>
                    <controls:SettingRow
                        Description="{loc:Loc Config_LockPromptCountHint}"
                        Error="{Binding LockPromptCountError}"
                        Header="{loc:Loc Config_LockPromptCount}"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Proximity.LockPromptSampleCount}">
                        <controls:UnitTextBox AutomationProperties.Name="{loc:Loc Config_LockPromptCount}" Text="{Binding LockPromptCountText, UpdateSourceTrigger=PropertyChanged}" Unit="{loc:Loc Unit_Readings}" />
                    </controls:SettingRow>
                    <controls:SettingRow
                        Description="{loc:Loc Config_LockConfirmCountHint}"
                        Error="{Binding LockConfirmCountError}"
                        Header="{loc:Loc Config_LockConfirmCount}"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Proximity.LockConfirmSampleCount}">
                        <controls:UnitTextBox AutomationProperties.Name="{loc:Loc Config_LockConfirmCount}" Text="{Binding LockConfirmCountText, UpdateSourceTrigger=PropertyChanged}" Unit="{loc:Loc Unit_Readings}" />
                    </controls:SettingRow>
                    <controls:SettingRow
                        Description="{loc:Loc Config_SampleIntervalHint}"
                        Error="{Binding SampleIntervalError}"
                        Header="{loc:Loc Config_SampleInterval}"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Proximity.SampleIntervalMs}">
                        <controls:UnitTextBox AutomationProperties.Name="{loc:Loc Config_SampleInterval}" Text="{Binding SampleIntervalText, UpdateSourceTrigger=PropertyChanged}" Unit="{loc:Loc Unit_Milliseconds}" />
                    </controls:SettingRow>
                    <controls:SettingRow
                        Description="{loc:Loc Config_StartupGraceHint}"
                        Error="{Binding StartupGraceError}"
                        Header="{loc:Loc Config_StartupGrace}"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Proximity.StartupGraceSeconds}">
                        <controls:UnitTextBox AutomationProperties.Name="{loc:Loc Config_StartupGrace}" Text="{Binding StartupGraceText, UpdateSourceTrigger=PropertyChanged}" Unit="{loc:Loc Unit_Seconds}" />
                    </controls:SettingRow>
                    <controls:SettingRow
                        Description="{loc:Loc Config_PendingTimeoutHint}"
                        Error="{Binding UnlockPendingTimeoutError}"
                        Header="{loc:Loc Config_PendingTimeout}"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Proximity.UnlockPendingTimeoutSeconds}">
                        <controls:UnitTextBox AutomationProperties.Name="{loc:Loc Config_PendingTimeout}" Text="{Binding UnlockPendingTimeoutText, UpdateSourceTrigger=PropertyChanged}" Unit="{loc:Loc Unit_Seconds}" />
                    </controls:SettingRow>
                    <controls:SettingRow
                        Description="{loc:Loc Config_NoSignalDepartureHint}"
                        Error="{Binding NoSignalDepartureError}"
                        Header="{loc:Loc Config_NoSignalDeparture}"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Proximity.NoSignalDepartureSeconds}">
                        <controls:UnitTextBox AutomationProperties.Name="{loc:Loc Config_NoSignalDeparture}" Text="{Binding NoSignalDepartureText, UpdateSourceTrigger=PropertyChanged}" Unit="{loc:Loc Unit_Seconds}" />
                    </controls:SettingRow>

                    <!--  ===== Aviso de bloqueo =====  -->
                    <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc Config_LockPrompt}" />
                    <controls:SettingRow
                        Description="{loc:Loc Config_PromptStyleHint}"
                        Header="{loc:Loc Config_PromptStyle}"
                        Icon="Alert20"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Notification.Mode}">
                        <ComboBox
                            Width="200"
                            AutomationProperties.Name="{loc:Loc Config_PromptStyle}"
                            SelectedIndex="{Binding NotifierModeIndex}">
                            <ComboBoxItem Content="{loc:Loc Config_PromptToast}" />
                            <ComboBoxItem Content="{loc:Loc Config_PromptDialog}" />
                        </ComboBox>
                    </controls:SettingRow>
                    <controls:SettingRow
                        Description="{loc:Loc Config_RejectSnoozeHint}"
                        Error="{Binding RejectSnoozeError}"
                        Header="{loc:Loc Config_RejectSnooze}"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Notification.RejectSnoozeSeconds}">
                        <controls:UnitTextBox AutomationProperties.Name="{loc:Loc Config_RejectSnooze}" Text="{Binding RejectSnoozeText, UpdateSourceTrigger=PropertyChanged}" Unit="{loc:Loc Unit_Seconds}" />
                    </controls:SettingRow>
                    <controls:SettingRow
                        Description="{loc:Loc Config_SnoozeHint}"
                        Error="{Binding SnoozeError}"
                        Header="{loc:Loc Config_Snooze}"
                        IsModified="{Binding ModifiedFields, Converter={StaticResource FieldModified}, ConverterParameter=Notification.SnoozeMinutes}">
                        <controls:UnitTextBox AutomationProperties.Name="{loc:Loc Config_Snooze}" Text="{Binding SnoozeText, UpdateSourceTrigger=PropertyChanged}" Unit="{loc:Loc Unit_Minutes}" />
                    </controls:SettingRow>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

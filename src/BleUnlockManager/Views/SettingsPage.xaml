<UserControl
    x:Class="BleUnlockManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BleUnlockManager.Views.Controls"
    xmlns:loc="clr-namespace:BleUnlockManager.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Loaded="OnLoaded">

    <UserControl.Resources>
        <Style x:Key="GroupTitle" BasedOn="{StaticResource Ui.TextStyle.BodyStrong}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>

        <!--  Tarjeta de tema: vista previa en miniatura + radio; seleccionada = borde de acento  -->
        <Style x:Key="ThemeTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <!--  El estilo de tema del sistema (Aero2) fija el texto en negro: se usa el pincel del tema  -->
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text.Primary}" />
            <Setter Property="GroupName" Value="Theme" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ui.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Tile"
                            Padding="8,8,8,12"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Ui.Stroke.Card}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Ui.Radius.Card}">
                            <StackPanel>
                                <ContentPresenter Height="72" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Stroke="{DynamicResource Ui.Stroke.Control.Strong}"
                                        StrokeThickness="1" />
                                    <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Tag}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Ui.Bg.Subtle.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Ui.Primary}" />
                                <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Tile" Property="Padding" Value="7,7,7,11" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Ui.Primary}" />
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Fila de ubicación: nombre + ruta en monoespaciada + «打开文件夹»  -->
        <DataTemplate x:Key="PathRow">
            <Border Style="{StaticResource Ui.Card}">
                <DockPanel>
                    <Button
                        VerticalAlignment="Center"
                        Click="OnOpenPathClicked"
                        CommandParameter="{Binding Path}"
                        Content="{loc:Loc Settings_OpenFolder}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Ui.Button.Secondary}" />
                    <StackPanel Margin="36,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock
                            FontFamily="{StaticResource Ui.Font.Mono}"
                            Style="{StaticResource Ui.TextStyle.Caption}"
                            Text="{Binding Path}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource Ui.Content.MaxWidth.Settings}" Margin="32,32,32,40">
            <TextBlock Style="{StaticResource Ui.TextStyle.Title}" Text="{loc:Loc Settings_Title}" />
            <TextBlock
                Margin="0,4,0,8"
                Style="{StaticResource Ui.TextStyle.Secondary}"
                Text="{loc:Loc Settings_Subtitle}" />

            <!--  ===== Apariencia =====  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc Settings_Appearance}" />
            <Border Padding="0" Style="{StaticResource Ui.Card}">
                <StackPanel>
                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            HorizontalAlignment="Left"
                            FontSize="20"
                            Foreground="{DynamicResource Ui.Icon.Primary}"
                            Symbol="DarkTheme20" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Settings_AppTheme}" />
                            <TextBlock Style="{StaticResource Ui.TextStyle.Caption}" Text="{loc:Loc Settings_AppThemeHint}" />
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{DynamicResource Ui.Stroke.Divider}" BorderThickness="0,1,0,0">
                        <UniformGrid
                            Margin="16"
                            AutomationProperties.Name="{loc:Loc Settings_AppTheme}"
                            Columns="3">
                            <RadioButton
                                Margin="0,0,8,0"
                                AutomationProperties.Name="{loc:Loc Theme_System}"
                                IsChecked="{Binding IsSystemTheme}"
                                Style="{StaticResource ThemeTile}"
                                Tag="{loc:Loc Theme_System}">
                                <Border BorderBrush="{DynamicResource Ui.Stroke.Card}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <UniformGrid Columns="2">
                                        <Border Padding="8" Background="#F3F3F3"><Border Background="#FFFFFF" CornerRadius="4" /></Border>
                                        <Border Padding="8" Background="#1C1C1C"><Border Background="#242424" CornerRadius="4" /></Border>
                                    </UniformGrid>
                                </Border>
                            </RadioButton>
                            <RadioButton
                                Margin="4,0"
                                AutomationProperties.Name="{loc:Loc Theme_Light}"
                                IsChecked="{Binding IsLightTheme}"
                                Style="{StaticResource ThemeTile}"
                                Tag="{loc:Loc Theme_Light}">
                                <Border Padding="28,8,8,8" Background="#F3F3F3" BorderBrush="{DynamicResource Ui.Stroke.Card}" BorderThickness="1" CornerRadius="4">
                                    <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" />
                                </Border>
                            </RadioButton>
                            <RadioButton
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{loc:Loc Theme_Dark}"
                                IsChecked="{Binding IsDarkTheme}"
                                Style="{StaticResource ThemeTile}"
                                Tag="{loc:Loc Theme_Dark}">
                                <Border Padding="28,8,8,8" Background="#1C1C1C" BorderBrush="{DynamicResource Ui.Stroke.Card}" BorderThickness="1" CornerRadius="4">
                                    <Border Background="#242424" CornerRadius="4" />
                                </Border>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ===== Idioma: único ajuste del equipo, se guarda en la configuración del servicio =====  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc Settings_LanguageGroup}" />
            <controls:SettingRow
                Description="{loc:Loc Settings_LanguageDescription}"
                Header="{loc:Loc Settings_LanguageHeader}"
                Icon="LocalLanguage20">
                <ComboBox
                    MinWidth="220"
                    AutomationProperties.Name="{loc:Loc Settings_LanguageHeader}"
                    IsEnabled="{Binding CanChangeLanguage}"
                    SelectedIndex="{Binding LanguageIndex}">
                    <ComboBoxItem Content="{loc:Loc Language_System}" />
                    <ComboBoxItem Content="{loc:Loc Language_Chinese}" />
                    <ComboBoxItem Content="{loc:Loc Language_English}" />
                    <ComboBoxItem Content="{loc:Loc Language_Spanish}" />
                </ComboBox>
            </controls:SettingRow>
            <TextBlock
                Margin="16,6,0,0"
                Foreground="{DynamicResource Ui.Status.Warning.Fg}"
                Style="{StaticResource Ui.TextStyle.Caption}"
                Text="{Binding LanguageNote}"
                TextWrapping="Wrap"
                Visibility="{Binding HasLanguageNote, Converter={StaticResource BoolToVisibility}}" />

            <!--  ===== Arranque =====  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc Settings_Startup}" />
            <controls:SettingRow
                Description="{loc:Loc Settings_AutoStartHint}"
                Header="{loc:Loc Settings_AutoStart}"
                Icon="Power20">
                <Border Style="{StaticResource Ui.StatusBadge.Tone}" Tag="{Binding AutoStartTone}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Symbol="{Binding AutoStartTone, Converter={StaticResource ToneToSymbol}}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding AutoStartText}" />
                    </StackPanel>
                </Border>
            </controls:SettingRow>

            <!--  ===== Ubicación de los ficheros =====  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc Settings_FileLocations}" />
            <ContentPresenter Content="{Binding ConfigLocation, RelativeSource={RelativeSource AncestorType=UserControl}}" ContentTemplate="{StaticResource PathRow}" />
            <ContentPresenter Content="{Binding LogsLocation, RelativeSource={RelativeSource AncestorType=UserControl}}" ContentTemplate="{StaticResource PathRow}" />
            <ContentPresenter Content="{Binding InstallLocation, RelativeSource={RelativeSource AncestorType=UserControl}}" ContentTemplate="{StaticResource PathRow}" />

            <!--  ===== Acerca de =====  -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc Settings_About}" />
            <controls:SettingRow
                Description="{loc:Loc Settings_VersionHint}"
                Header="{loc:Loc Settings_Version}"
                Icon="Info20">
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Loc Settings_Version}"
                    FontFamily="{StaticResource Ui.Font.Mono}"
                    Text="{Binding Version}" />
            </controls:SettingRow>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Version desde las etiquetas git vX.Y.Z (MinVer); el script del instalador crea una etiqueta nueva en cada paquete -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BleUnlockManager</RootNamespace>
    <AssemblyName>BleUnlockManager</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <!-- El proyecto XAML temporal de WPF no carga los analizadores de paquetes por defecto;
         sin esto el generador de código de MVVM Toolkit no se ejecuta -->
    <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BleUnlockManager.Core\BleUnlockManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icono de ventana y de reserva de la bandeja: se distribuye con la publicación -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>


</Project>
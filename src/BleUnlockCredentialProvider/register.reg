Windows Registry Editor Version 5.00

; Register COM InprocServer (update path after DLL placement)
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{6D9E3F7A-2C8B-4E5D-A1F0-3B7C9D2E6F4A}]
@="BleUnlock Credential Provider"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{6D9E3F7A-2C8B-4E5D-A1F0-3B7C9D2E6F4A}\InprocServer32]
@="C:\\Program Files\\BleUnlock\\BleUnlockCP.dll"
"ThreadingModel"="Apartment"

; Register as Credential Provider
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{6D9E3F7A-2C8B-4E5D-A1F0-3B7C9D2E6F4A}]
@="BleUnlock Credential Provider"

  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AutoUnlockService.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

{
  "AutoUnlock": {
    "ComPort": "COM3",
    "BaudRate": 9600,
    "NearThreshold": -60,
    "FarThreshold": -80,
    "SmoothingWindow": 5,
    "UnlockConfirmCount": 3,
    "LockConfirmCount": 5,
    "CredentialTarget": "AutoUnlock"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "SourceName": "AutoUnlockService",
      "LogName": "Application"
    }
  }
}
